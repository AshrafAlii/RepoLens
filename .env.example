# ── Authentication ───────────────────────────────────────────────────────────
# Password required to open the vault. The server refuses all API requests
# while this is unset.
APP_PASSWORD=change-me

# Signs the session cookie. Optional, but set it in production: rotating it
# signs every existing session out. If omitted, a value is derived from
# APP_PASSWORD (so sessions survive restarts).
# SESSION_SECRET=

# ── GitHub storage ───────────────────────────────────────────────────────────
# Fine-grained token with "Contents: Read and write" on the storage repo only.
# The repo does not need to be public.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
GITHUB_USERNAME=your-github-username
GITHUB_REPO=your-repo-name
# Branch that holds the media/ and thumbs/ folders.
GITHUB_BRANCH=main

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
